<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SmartPipePackage>true</SmartPipePackage>
  </PropertyGroup>
  <Import Project="$(SmartPipeRepositoryRoot)eng/SmartPipe.Package.props" />
  <PropertyGroup>
    <PackageId>SmartPipe.Extensions.Transforms</PackageId>
    <Description>Composable transforms for SmartPipe.Core.</Description>
    <PackageReleaseNotes>First standalone release in 2.2.0. Composition, filtering, conditional processing and compression move to a Core-based leaf; facade type forwarders preserve legacy identities. Trimming and NativeAOT supported.</PackageReleaseNotes>
    <PackageTags>SmartPipe;pipeline;transforms</PackageTags>
    <SmartPipePackageReadmeSource>$(MSBuildProjectDirectory)/README.md</SmartPipePackageReadmeSource>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SmartPipe.Core/SmartPipe.Core.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartPipe.Extensions.Transforms.Tests" />
  </ItemGroup>

</Project>
