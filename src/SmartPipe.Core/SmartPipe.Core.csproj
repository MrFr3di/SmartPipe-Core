<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SmartPipePackage>true</SmartPipePackage>
  </PropertyGroup>
  <Import Project="$(SmartPipeRepositoryRoot)eng/SmartPipe.Package.props" />
  <PropertyGroup>
    <PackageId>SmartPipe.Core</PackageId>
    <PackageReleaseNotes>SmartPipe $(SmartPipeVersionPrefix) servicing release. Preserves the public API validated against $(SmartPipePreviousStableVersion) and hardens backpressure-delay continuation behavior without changing the contract.</PackageReleaseNotes>
    <Description>Streaming pipeline engine for .NET based on System.Threading.Channels with source, transform, sink, resilience, diagnostics, and compatibility APIs.</Description>
    <PackageTags>etl;pipeline;channels;in-process;streaming;dataflow;resilience;circuit-breaker;retry;dead-letter;deduplication;performance</PackageTags>
    <SmartPipePackageReadmeSource>$(SmartPipeRepositoryRoot)README.md</SmartPipePackageReadmeSource>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SmartPipe.Core.Tests" />
    <InternalsVisibleTo Include="SmartPipe.Benchmarks" />
    <InternalsVisibleTo Include="SmartPipe.Extensions.DependencyInjection" />
    <InternalsVisibleTo Include="SmartPipe.Extensions.DependencyInjection.Tests" />
  </ItemGroup>
</Project>
