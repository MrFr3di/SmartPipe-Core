<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SmartPipePackage>true</SmartPipePackage>
  </PropertyGroup>
  <Import Project="$(SmartPipeRepositoryRoot)eng/SmartPipe.Package.props" />
  <PropertyGroup>
    <PackageId>SmartPipe.Extensions.DependencyInjection</PackageId>
    <Description>SmartPipe framework integration package for SmartPipe.Extensions.DependencyInjection.</Description>
    <PackageReleaseNotes>First standalone release in 2.2.0. Adds canonical key-based pipeline registration and runtime ownership. The legacy generic DI cluster remains frozen in SmartPipe.Extensions; migration is explicit. Trimming and NativeAOT supported.</PackageReleaseNotes>
    <PackageTags>SmartPipe;pipeline;framework-integration</PackageTags>
    <SmartPipePackageReadmeSource>$(MSBuildProjectDirectory)/README.md</SmartPipePackageReadmeSource>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SmartPipe.Core/SmartPipe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartPipe.Extensions.DependencyInjection.Tests" />
  </ItemGroup>

</Project>
