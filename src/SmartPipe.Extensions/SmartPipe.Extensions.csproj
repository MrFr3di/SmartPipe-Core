<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SmartPipePackage>true</SmartPipePackage>
  </PropertyGroup>
  <Import Project="$(SmartPipeRepositoryRoot)eng/SmartPipe.Package.props" />
  <PropertyGroup>
    <PackageId>SmartPipe.Extensions</PackageId>
    <Description>Compatibility facade and convenience bundle for SmartPipe.Core and its runtime integration packages. New applications should reference specific SmartPipe.Extensions.* packages. Retained 2.1.2 APIs use type forwarding or the frozen legacy DI/Hosting/Health cluster; removed HTTP/Polly APIs require migration and recompilation.</Description>
    <PackageTags>etl;pipeline;polly;efcore;dapper;mapster;csvhelper;json;compression</PackageTags>
    <SmartPipePackageReadmeSource>$(MSBuildProjectDirectory)\README.md</SmartPipePackageReadmeSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackageValidationBaselineVersion)' == '2.1.2'">
    <ApiCompatSuppressionFile Include="$(MSBuildProjectDirectory)\CompatibilitySuppressions.2.1.2-to-2.2.0.xml" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SmartPipe.Extensions.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartPipe.Core\SmartPipe.Core.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Channels\SmartPipe.Extensions.Channels.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Transforms\SmartPipe.Extensions.Transforms.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Logging\SmartPipe.Extensions.Logging.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.DataAnnotations\SmartPipe.Extensions.DataAnnotations.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.DependencyInjection\SmartPipe.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Hosting\SmartPipe.Extensions.Hosting.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.HealthChecks\SmartPipe.Extensions.HealthChecks.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.OpenTelemetry\SmartPipe.Extensions.OpenTelemetry.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Json\SmartPipe.Extensions.Json.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Csv\SmartPipe.Extensions.Csv.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Dapper\SmartPipe.Extensions.Dapper.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.EntityFrameworkCore\SmartPipe.Extensions.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Mapster\SmartPipe.Extensions.Mapster.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Http\SmartPipe.Extensions.Http.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Http.Json\SmartPipe.Extensions.Http.Json.csproj" />
    <ProjectReference Include="..\SmartPipe.Extensions.Polly\SmartPipe.Extensions.Polly.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Mapster" />
    <PackageReference
      Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
      PrivateAssets="all"
    />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
