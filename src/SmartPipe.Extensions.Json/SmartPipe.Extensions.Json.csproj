<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SmartPipePackage>true</SmartPipePackage>
  </PropertyGroup>
  <Import Project="$(SmartPipeRepositoryRoot)eng/SmartPipe.Package.props" />
  <PropertyGroup>
    <PackageId>SmartPipe.Extensions.Json</PackageId>
    <Description>System.Text.Json-based sources, sinks, transforms, and dead-letter persistence for SmartPipe.Core with trimming and NativeAOT support.</Description>
    <PackageTags>smartpipe;pipeline;json;system-text-json;jsonl;serialization;nativeaot;trimming</PackageTags>
    <SmartPipePackageReadmeSource>$(MSBuildProjectDirectory)\README.md</SmartPipePackageReadmeSource>
    <PackageValidationBaselineVersion>2.1.2</PackageValidationBaselineVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartPipe.Core\SmartPipe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartPipe.Extensions.Json.Tests" />
  </ItemGroup>

</Project>
