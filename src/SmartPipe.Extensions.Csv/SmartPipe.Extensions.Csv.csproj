<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SmartPipePackage>true</SmartPipePackage>
  </PropertyGroup>
  <Import Project="$(SmartPipeRepositoryRoot)eng/SmartPipe.Package.props" />
  <PropertyGroup>
    <PackageId>SmartPipe.Extensions.Csv</PackageId>
    <Description>Strict, bounded CSV sources and sinks for SmartPipe.Core.</Description>
    <PackageReleaseNotes>First standalone release in 2.2.0. CSV source, sink and transform identities move from the facade with type forwarding; strict bounded file APIs are available. CsvHelper reflection paths do not carry a blanket trimming or NativeAOT guarantee.</PackageReleaseNotes>
    <PackageTags>smartpipe;pipeline;csv;csvhelper;streaming</PackageTags>
    <SmartPipePackageReadmeSource>$(MSBuildProjectDirectory)\README.md</SmartPipePackageReadmeSource>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartPipe.Core\SmartPipe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartPipe.Extensions.Csv.Tests" />
    <InternalsVisibleTo Include="SmartPipe.Benchmarks" />
  </ItemGroup>
</Project>
