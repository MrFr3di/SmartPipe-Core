<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SmartPipePackage>true</SmartPipePackage>
  </PropertyGroup>
  <Import Project="$(SmartPipeRepositoryRoot)eng/SmartPipe.Package.props" />
  <PropertyGroup>
    <PackageId>SmartPipe.Extensions.EntityFrameworkCore</PackageId>
    <Description>Provider-neutral Entity Framework Core query sources for SmartPipe.Core.</Description>
    <PackageReleaseNotes>First standalone release in 2.2.0. EfCoreSelector moves from the facade with forwarding; provider-neutral query sources use documented DbContext ownership. EF Core reflection paths do not carry a blanket trimming or NativeAOT guarantee.</PackageReleaseNotes>
    <PackageTags>smartpipe;pipeline;efcore;entity-framework;streaming</PackageTags>
    <SmartPipePackageReadmeSource>$(MSBuildProjectDirectory)\README.md</SmartPipePackageReadmeSource>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartPipe.Core\SmartPipe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartPipe.Extensions.EntityFrameworkCore.Tests" />
  </ItemGroup>
</Project>
