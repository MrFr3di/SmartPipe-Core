<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SmartPipePackage>true</SmartPipePackage>
  </PropertyGroup>
  <Import Project="$(SmartPipeRepositoryRoot)eng/SmartPipe.Package.props" />
  <PropertyGroup>
    <PackageId>SmartPipe.Extensions.OpenTelemetry</PackageId>
    <Description>Exporter-neutral OpenTelemetry registration for SmartPipe pipeline metrics and tracing.</Description>
    <PackageReleaseNotes>First standalone release in 2.2.0. Adds exporter-neutral registration for pipeline metrics and tracing. Included in the facade convenience bundle; exporters remain application-owned. Trimming and NativeAOT supported.</PackageReleaseNotes>
    <PackageTags>SmartPipe;pipeline;opentelemetry;metrics;tracing</PackageTags>
    <SmartPipePackageReadmeSource>$(MSBuildProjectDirectory)/README.md</SmartPipePackageReadmeSource>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SmartPipe.Core/SmartPipe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartPipe.Extensions.OpenTelemetry.Tests" />
  </ItemGroup>

</Project>
