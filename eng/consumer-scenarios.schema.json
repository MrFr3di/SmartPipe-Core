{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartpipe.dev/schemas/consumer-scenarios.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requiredAtRelease", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requiredAtRelease": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set", "mode", "templatePath", "packageIds", "expectedSmartPipeDependencies", "forbiddenDependencies", "baselineVersion", "timeout", "runSecondLockedRestore"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "set": { "const": "current" },
        "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "mode": { "enum": ["build-and-run", "publish-trimmed", "publish-native-aot", "binary-compatibility"] },
        "templatePath": { "type": "string", "pattern": "^tests/Consumers/Scenarios/[a-z0-9-]+/[^/]+\\.(cs|csproj)$" },
        "packageIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "expectedSmartPipeDependencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "forbiddenDependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "baselineVersion": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "expectedPublishDiagnostic": { "$ref": "#/$defs/expectedPublishDiagnostic" },
        "timeout": { "type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]$" },
        "runSecondLockedRestore": { "type": "boolean" }
      }
    },
    "expectedPublishDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "sourcePath", "line", "msBuildProperties"],
      "properties": {
        "code": { "type": "string", "pattern": "^IL[0-9]{4}$" },
        "sourcePath": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.cs$" },
        "line": { "type": "integer", "minimum": 1 },
        "msBuildProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]*=(?:true|false)$" }
        }
      }
    }
  }
}
