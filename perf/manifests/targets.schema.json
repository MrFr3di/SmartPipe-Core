{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartpipe.dev/schemas/perf-targets-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "integrationAtLabBootstrap", "fullCandidate"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "gitSha", "source", "manifest"],
      "properties": {
        "id": { "const": "smartpipe-2.1.2" },
        "version": { "const": "2.1.2" },
        "gitSha": { "const": "8e79902d22de714f493582946f7c260462b0895e" },
        "source": { "const": "published-nuget-baseline" },
        "manifest": { "const": "eng/baselines/2.1.2/manifest.json" }
      }
    },
    "integrationAtLabBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gitSha", "includedEpics", "authoritativeFullCandidate"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "includedEpics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SP220-(0[1-9]|1[0-2])$" }
        },
        "authoritativeFullCandidate": { "const": false }
      }
    },
    "fullCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "gitSha", "status", "requiredEpics"],
      "properties": {
        "id": { "const": "smartpipe-2.2.0-sp220-01-12" },
        "version": { "const": "2.2.0" },
        "gitSha": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          ]
        },
        "status": { "enum": ["blocked-on-sp220-12", "pinned"] },
        "requiredEpics": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SP220-(0[1-9]|1[0-2])$" }
        }
      }
    }
  }
}
