{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartpipe.dev/schemas/perf-targets-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "candidate"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "gitSha", "source", "manifest"],
      "properties": {
        "id": { "const": "smartpipe-2.1.2" },
        "version": { "const": "2.1.2" },
        "gitSha": { "const": "8e79902d22de714f493582946f7c260462b0895e" },
        "source": { "const": "published-nuget-baseline" },
        "manifest": { "const": "eng/baselines/2.1.2/manifest.json" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "gitSha", "status", "includedEpics", "excludedEpics"],
      "properties": {
        "id": { "const": "smartpipe-2.2.0-sp220-01-11" },
        "version": { "const": "2.2.0" },
        "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "status": { "const": "pinned" },
        "includedEpics": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SP220-(0[1-9]|1[01])$" }
        },
        "excludedEpics": {
          "const": ["SP220-12"]
        }
      }
    }
  }
}
