{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartpipe.dev/schemas/perf-scenarios-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups", "classes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "classes": {
      "const": ["strict-ab", "evolution", "v220-only"]
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "epics", "defaultClass", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "epics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SP220-(0[1-9]|1[0-2])$" }
          },
          "defaultClass": { "enum": ["strict-ab", "evolution", "v220-only"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    }
  }
}
