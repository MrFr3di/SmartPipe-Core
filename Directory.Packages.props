<Project>
  <Import Project="$(MSBuildThisFileDirectory)eng/SmartPipe.Versions.props" />

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Mapster" Version="10.0.13" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <PackageVersion Include="SmartPipe.Core" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Testing" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.DependencyInjection" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Channels" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.DataAnnotations" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Logging" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Transforms" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.HealthChecks" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Hosting" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Csv" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Dapper" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.EntityFrameworkCore" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Mapster" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Polly" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.PostgreSql" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Http" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Http.Json" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.Json" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SmartPipe.Extensions.OpenTelemetry" Version="$(SmartPipePreviousStableVersion)" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>
</Project>
